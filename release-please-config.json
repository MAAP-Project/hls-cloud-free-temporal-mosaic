{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-v-in-tag": true,
  "always-update": true,
  "packages": {
    ".": {
      "release-type": "python",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "hls-cloud-free-temporal-mosaic.cwl"
        },
        {
          "type": "generic",
          "path": "main.py"
        },
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": "tests/test_runtime.py"
        },
        {
          "type": "generic",
          "path": "hls-cloud-free-temporal-mosaics.ipynb"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value == 'hls-cloud-free-temporal-mosaic')].version"
        }
      ]
    }
  }
}
